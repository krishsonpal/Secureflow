# Overrides for docker-compose.yml (compose auto-loads this file). Copy to .env
# and fill real secrets before any non-local use. All have safe local defaults.

# --- Secrets (CHANGE THESE) ---
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
# Token lifetimes (required — jsonwebtoken throws if unset at sign time).
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d
GRAFANA_PASSWORD=admin

# --- ML service auth (set the SAME value on ml + backend to enable auth) ---
# Leave empty to run the ML service open (local dev).
ML_API_KEY=
UVICORN_WORKERS=2

# --- Wiring (defaults target the compose service names) ---
MONGODB_URI=mongodb://mongo:27017/
DB_NAME=SECUREFLOW
REDIS_URL=redis://redis:6379
MICROSERVICE_URI=http://ml:7860/predict
FRONTEND_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3000
LOG_LEVEL=info
