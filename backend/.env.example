# SecureFlow backend configuration — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# --- Server ---
PORT=3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=SECUREFLOW

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (use TWO DIFFERENT strong random secrets) ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_random_hex
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_DIFFERENT_random_hex
REFRESH_TOKEN_EXPIRY=10d

# --- CORS / frontend origins (comma-separated, no wildcard) ---
FRONTEND_URL=http://localhost:5173,http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# --- ML microservice ---
MICROSERVICE_URI=http://localhost:8000/predict

# --- Mailer (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com
